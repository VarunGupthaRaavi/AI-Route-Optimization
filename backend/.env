ENVIRONMENT=development
PROJECT_NAME="RouteAI Enterprise Logistics Platform"
API_V1_STR=/api/v1
DEBUG=true

HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# SQLite fallback URL for instant dev testing without external DB setup if needed, or PostgreSQL URL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/routeai_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

JWT_SECRET_KEY=dev-jwt-secret-key-change-this-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

LOG_LEVEL=DEBUG
LOG_FORMAT=console
