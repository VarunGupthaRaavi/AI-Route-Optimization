# ===================================================================
# ROUTEAI BACKEND PRODUCTION ENVIRONMENT CONFIGURATION (RENDER + SUPABASE)
# ===================================================================
PROJECT_NAME="RouteAI Enterprise Logistics Engine"
ENVIRONMENT="production"
DEBUG=false

# Supabase Managed PostgreSQL Database Connection
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres"

# Supabase API Credentials
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# CORS Origins for Vercel Deployments
CORS_ORIGINS=["https://*.vercel.app", "https://routeai.vercel.app"]

# Security & JWT Token Signing
JWT_SECRET_KEY="REPLACE_WITH_PRODUCTION_SECRET_KEY_MIN_32_BYTES"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini API Key
GEMINI_API_KEY="YOUR_PRODUCTION_GEMINI_API_KEY"
GEMINI_MODEL="gemini-1.5-flash"

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
