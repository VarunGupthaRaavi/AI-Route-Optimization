# RouteAI Environment Variables Template
# Environment: development, staging, production
ENVIRONMENT=development
PROJECT_NAME="RouteAI Enterprise Logistics Platform"
API_V1_STR=/api/v1
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Settings (comma-separated origins or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database Connection (Supabase / PostgreSQL)
# Format for Async SQLAlchemy: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres.your_project_id:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Additional Database Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Security & JWT Configuration
JWT_SECRET_KEY=super-secret-jwt-key-replace-in-production-with-random-uuid
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
